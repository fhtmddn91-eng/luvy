generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  companyName    String
  businessNumber String
  /** 사업자등록증 첨부 파일명 (private-uploads/bizcert/ 아래, 관리자만 열람) */
  bizCertFile    String     @default("")
  ownerName      String
  phone          String
  status         String     @default("APPROVED")
  role           String     @default("MEMBER")
  createdAt      DateTime   @default(now())
  cartItems      CartItem[]
  orders         Order[]
  inquiries      Inquiry[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  brand        String
  categorySlug String
  description  String
  image        String      @default("")
  basePrice    Int
  status       String      @default("ACTIVE")
  /**
   * 재고 추적 여부. 무재고(주문 후 사입) 상품은 false로 두어 수량 제한 없이 판매한다.
   * 기존 상품이 갑자기 품절되지 않도록 기본값은 false.
   */
  trackStock   Boolean     @default(false)
  stock        Int         @default(0)
  /** 수입 원본 (1688 등). sourceId 로 같은 상품 재수집을 막는다. */
  sourceUrl    String      @default("")
  sourceId     String?     @unique
  createdAt    DateTime    @default(now())
  priceTiers   PriceTier[]
  cartItems    CartItem[]
  assets       ProductAsset[]

  @@index([categorySlug])
}

/**
 * 상품별 판매자료 — 상세페이지 이미지 / 썸네일 / GIF.
 * 승인 회원이 상품 페이지에서 내려받는다.
 */
model ProductAsset {
  id        String   @id @default(cuid())
  productId String
  kind      String // MAIN | DETAIL | GIF | OPTION
  url       String // 미러링된 로컬 경로 (/uploads/..)
  bytes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/** 1688 수집 이력 — 실패 원인 추적과 재시도를 위해 남긴다. */
model ImportJob {
  id        String   @id @default(cuid())
  source    String   @default("1688")
  sourceId  String
  sourceUrl String
  status    String   @default("PENDING") // PENDING | DONE | FAILED
  rawTitle  String   @default("")
  koTitle   String   @default("")
  imageCount Int     @default(0)
  error     String?
  productId String?
  createdAt DateTime @default(now())

  @@index([status])
}

model PriceTier {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  unitPrice Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  status      String      @default("RECEIVED")
  recipient   String
  phone       String
  address     String
  memo        String?
  subtotal    Int
  shippingFee Int
  total       Int
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  paymentId   String    @unique // 포트원 결제 식별자 (고객사 채번)
  pgTxId      String?
  channel     String    @default("kcp")
  method      String? // CARD | TRANSFER | EASY_PAY
  amount      Int
  status      String    @default("READY") // READY | PAID | CANCELED | FAILED
  approvedAt  DateTime?
  canceledAt  DateTime?
  rawResponse String?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  brand     String
  unitPrice Int
  quantity  Int
  lineTotal Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Banner {
  id             String   @id @default(cuid())
  eyebrow        String
  title          String
  subtitle       String
  primaryLabel   String
  primaryHref    String
  secondaryLabel String
  secondaryHref  String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  kind      String   // notice | stock | event
  tag       String
  text      String
  body      String   @default("") // 공지 상세 본문 (비어 있으면 목록에서 상세 링크 없이 표시)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Inquiry {
  id         String    @id @default(cuid())
  userId     String
  type       String // GENERAL | PARTNER_APPLY | BULK | ALLIANCE
  title      String
  content    String
  status     String    @default("OPEN") // OPEN | ANSWERED
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
