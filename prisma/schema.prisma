generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  companyName    String
  businessNumber String
  /** 사업자등록증 첨부 파일명 (private-uploads/bizcert/ 아래, 관리자만 열람) */
  bizCertFile    String     @default("")
  /**
   * 세션 무효화 카운터. 비밀번호가 바뀌면 +1 하고, 발급된 토큰에 이 값을 넣어
   * 불일치하는(= 예전 비밀번호로 로그인한) 세션을 즉시 끊는다.
   */
  sessionVersion Int        @default(0)
  ownerName      String
  phone          String
  status         String     @default("APPROVED")
  role           String     @default("MEMBER")
  createdAt      DateTime   @default(now())
  cartItems      CartItem[]
  orders         Order[]
  inquiries      Inquiry[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  brand        String
  categorySlug String
  description  String
  image        String      @default("")
  basePrice    Int
  status       String      @default("ACTIVE")
  /**
   * 재고 추적 여부. 무재고(주문 후 사입) 상품은 false로 두어 수량 제한 없이 판매한다.
   * 기존 상품이 갑자기 품절되지 않도록 기본값은 false.
   */
  trackStock   Boolean     @default(false)
  stock        Int         @default(0)
  /** 수입 원본 (1688 등). sourceId 로 같은 상품 재수집을 막는다. */
  sourceUrl    String      @default("")
  sourceId     String?     @unique
  createdAt    DateTime    @default(now())
  priceTiers   PriceTier[]
  cartItems    CartItem[]
  assets       ProductAsset[]

  @@index([categorySlug])
}

/**
 * 상품별 판매자료 — 상세페이지 이미지 / 썸네일 / GIF.
 * 승인 회원이 상품 페이지에서 내려받는다.
 */
model ProductAsset {
  id        String   @id @default(cuid())
  productId String
  kind      String // MAIN | DETAIL | GIF | OPTION
  url       String // 미러링된 로컬 경로 (/uploads/..)
  bytes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/** 1688 수집 이력 — 실패 원인 추적과 재시도를 위해 남긴다. */
model ImportJob {
  id        String   @id @default(cuid())
  source    String   @default("1688")
  sourceId  String
  sourceUrl String
  status    String   @default("PENDING") // PENDING | DONE | FAILED
  rawTitle  String   @default("")
  koTitle   String   @default("")
  imageCount Int     @default(0)
  error     String?
  productId String?
  createdAt DateTime @default(now())

  @@index([status])
}

model PriceTier {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  unitPrice Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  status      String      @default("RECEIVED")
  recipient   String
  phone       String
  address     String
  memo        String?
  subtotal    Int
  shippingFee Int
  total       Int
  /** 택배사 코드 (src/lib/shipping.ts COURIERS). 미발송이면 빈 문자열 */
  courier     String      @default("")
  /** 운송장번호. 영숫자만 정규화해 저장하며, 비어 있으면 미발송 */
  trackingNo  String      @default("")
  shippedAt   DateTime?
  canceledAt  DateTime?
  /** 취소 주체. MEMBER | ADMIN (취소 전에는 빈 문자열) */
  canceledBy  String      @default("")
  cancelReason String     @default("")
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  paymentId   String    @unique // 포트원 결제 식별자 (고객사 채번)
  pgTxId      String?
  channel     String    @default("kcp")
  method      String? // CARD | TRANSFER | EASY_PAY
  amount      Int
  status      String    @default("READY") // READY | PAID | CANCELED | FAILED
  approvedAt  DateTime?
  canceledAt  DateTime?
  rawResponse String?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  brand     String
  unitPrice Int
  quantity  Int
  lineTotal Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Faq {
  id        String  @id @default(cuid())
  category  String
  question  String
  answer    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/** 운영자가 어드민에서 바꾸는 사이트 설정 (배송비 등). key-value 저장 */
model Setting {
  key   String @id
  value String
}

model Category {
  /** URL 에 그대로 쓰는 식별자 (예: women). 상품이 categorySlug 문자열로 참조한다. */
  slug      String  @id
  name      String
  /** Icon 컴포넌트 키 */
  icon      String  @default("sparkle")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Banner {
  id             String   @id @default(cuid())
  eyebrow        String
  title          String
  subtitle       String
  primaryLabel   String
  primaryHref    String
  secondaryLabel String
  secondaryHref  String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  kind      String   // notice | stock | event
  tag       String
  text      String
  body      String   @default("") // 공지 상세 본문 (비어 있으면 목록에서 상세 링크 없이 표시)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Inquiry {
  id         String    @id @default(cuid())
  userId     String
  type       String // GENERAL | PARTNER_APPLY | BULK | ALLIANCE
  title      String
  content    String
  status     String    @default("OPEN") // OPEN | ANSWERED
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * 감사 로그 — "누가 언제 무엇을 했는지".
 *
 * 승인·취소·환불·비밀번호 발급처럼 되돌리기 어렵거나 돈이 걸린 동작은
 * 기록이 없으면 사고가 났을 때 원인도 책임도 확인할 수 없다.
 * 로그는 앱에서 수정·삭제하지 않는다(append-only).
 */
model AuditLog {
  id        String   @id @default(cuid())
  /** 행위자. 시스템(웹훅 등)이면 null */
  actorId   String?
  /** 조회 화면에 그대로 보여줄 이름 — 회원이 탈퇴해도 기록이 남아야 한다 */
  actorName String   @default("")
  actorRole String   @default("")
  /** 무엇을 했는지 (src/lib/audit.ts AUDIT_ACTIONS) */
  action    String
  /** 대상 종류: order | member | product | setting ... */
  target    String   @default("")
  /** 대상 식별자 */
  targetId  String   @default("")
  /** 사람이 읽는 한 줄 요약 */
  summary   String   @default("")
  /** 변경 전/후 등 부가 정보 (JSON 문자열) */
  meta      String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([target, targetId])
}

/**
 * 상단 메뉴(GNB) — 이번주 추천 / 신상품 / 인기상품 / 기획전 / 고객지원.
 * 코드에 박아두면 문구 하나 바꾸는 데도 배포가 필요해 DB 로 옮겼다.
 */
model NavLink {
  id        String  @id @default(cuid())
  label     String
  href      String
  /** NEW 같은 작은 배지. 비우면 표시하지 않는다 */
  badge     String  @default("")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}
