generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  companyName    String
  businessNumber String
  /** 사업자등록증 첨부 파일명 (private-uploads/bizcert/ 아래, 관리자만 열람) */
  bizCertFile    String     @default("")
  /**
   * 세션 무효화 카운터. 비밀번호가 바뀌면 +1 하고, 발급된 토큰에 이 값을 넣어
   * 불일치하는(= 예전 비밀번호로 로그인한) 세션을 즉시 끊는다.
   */
  sessionVersion Int        @default(0)
  ownerName      String
  phone          String
  status         String     @default("APPROVED")
  role           String     @default("MEMBER")
  createdAt      DateTime   @default(now())
  cartItems      CartItem[]
  orders         Order[]
  inquiries      Inquiry[]
  wishlists      Wishlist[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  brand        String
  /**
   * 대표 카테고리. 상세 페이지 위치와 관리자 목록 표기에 쓴다.
   * 실제 "이 상품이 어느 목록에 뜨는가"는 ProductCategory 를 본다 —
   * 대표 카테고리도 거기에 항상 한 줄로 들어간다.
   */
  categorySlug String
  /**
   * 자체 품번. 운영자가 원하는 규칙으로 붙인다(예: LV-2601).
   * 안 쓰는 상품은 null — 빈 문자열로 두면 여러 상품이 unique 에 걸린다.
   */
  sku          String?     @unique
  description  String
  image        String      @default("")
  /**
   * 권장 소비자가. 거래처가 "얼마에 팔면 되는지" 바로 알 수 있게 도매가와 함께 노출한다.
   * 0 이면 아직 정하지 않은 것으로 보고 화면에 표시하지 않는다.
   */
  basePrice    Int
  status       String      @default("ACTIVE")
  /**
   * 재고 추적 여부. 무재고(주문 후 사입) 상품은 false로 두어 수량 제한 없이 판매한다.
   * 기존 상품이 갑자기 품절되지 않도록 기본값은 false.
   */
  trackStock   Boolean     @default(false)
  stock        Int         @default(0)
  /** 수입 원본 (1688 등). sourceId 로 같은 상품 재수집을 막는다. */
  sourceUrl    String      @default("")
  sourceId     String?     @unique
  /**
   * 판매 전환 요청 시각 — 번역 검증이 안 끝나 HIDDEN 으로 붙잡아 둔 상태.
   * 전 이미지가 검증을 통과하면 자동으로 ACTIVE 로 승격하고 비운다.
   * 번역 중·검수 대기인 중국어 이미지가 손님에게 먼저 보이는 창을 없앤다.
   */
  publishRequestedAt DateTime?
  createdAt    DateTime    @default(now())
  priceTiers   PriceTier[]
  cartItems    CartItem[]
  assets       ProductAsset[]
  categories   ProductCategory[]
  homePicks    HomePick[]
  wishlists    Wishlist[]
  options      ProductOption[]

  @@index([categorySlug])
}

/**
 * 상품 옵션 (색상·사이즈 등).
 *
 * 옵션마다 단가와 재고를 따로 둔다 — 같은 상품이라도 색상별로 사입가가
 * 다르고 재고도 따로 도는 게 실제 운영이다.
 * unitPrice 0 은 "따로 안 정함" — 상품의 수량별 도매가를 그대로 쓴다.
 */
model ProductOption {
  id         String  @id @default(cuid())
  productId  String
  name       String
  unitPrice  Int     @default(0)
  trackStock Boolean @default(false)
  stock      Int     @default(0)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/**
 * 찜(관심상품). 거래처가 발주 후보를 모아두는 용도라 수량·가격은 담지 않는다 —
 * 그건 장바구니(CartItem)의 몫.
 */
model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
}

/**
 * 상품 ↔ 카테고리 다대다. 한 상품을 여러 매대에 올리기 위한 것으로,
 * 대표 카테고리(Product.categorySlug)도 여기에 반드시 포함된다.
 * 그래야 목록 조회가 이 테이블 하나만 보면 된다.
 */
model ProductCategory {
  productId    String
  categorySlug String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@id([productId, categorySlug])
  @@index([categorySlug])
}

/**
 * 상품별 판매자료 — 상세페이지 이미지 / 썸네일 / GIF.
 * 승인 회원이 상품 페이지에서 내려받는다.
 */
model ProductAsset {
  id        String   @id @default(cuid())
  productId String
  kind      String // MAIN | DETAIL | GIF | OPTION
  url       String // 미러링된 로컬 경로 (/uploads/..)
  bytes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // 이미지 속 중국어 → 한국어 번역 (어드민에서 선택 실행)
  // 번역하면 url 은 번역본을 가리키고, 원본은 originalUrl 로 보존한다 —
  // 문구를 고쳐 다시 렌더하거나 원본으로 되돌릴 수 있어야 하기 때문.
  originalUrl String? // 번역 전 원본 (/uploads/..) — null 이면 미번역
  ocrData     String? // OCR 결과+번역 문구 JSON — 어드민에서 문구 수정 시 재렌더 근거

  // 번역 검증 상태 (2026-08-24 설계 v2.1).
  // null = 기록 없음(국내·수동 등록, 또는 구 파이프라인 번역본 legacy — 노출 허용).
  // VERIFIED · NO_FOREIGN_TEXT 만 검사를 실제 통과한 것이고, 나머지
  // (TRANSLATING · NEEDS_REVIEW · RETRYABLE · VERIFICATION_FAILED · FAILED)는
  // 전부 판매 노출 차단 — 불확실한 이미지는 손님에게 나가지 않는다.
  translateStatus String?
  reviewReasons   String? // NEEDS_REVIEW 등 사유 — JSON [{code, detail}]
  candidateUrl    String? // 검수 대기 번역 후보 (/uploads/..). url 은 원본 유지 — 승인해야 승격
  candidateOcr    String? // 후보에 딸린 OCR·번역문 JSON — 승인 시 ocrData 로 승격
  reviewedAt      DateTime? // 운영자가 승인/거부한 시각 — 자동 판정과 구분
  originalSha256  String? // 번역 원본 바이트의 SHA-256 — TranslationCache 연결·중복 측정

  @@index([productId])
  @@index([translateStatus])
}

/**
 * (원본 바이트, 파이프라인 버전) → 번역 결과 캐시. 같은 그림·같은 파이프라인은
 * 두 번 렌더하지 않는다 — VERIFIED 재호출 금지를 자산이 아니라 바이트 단위로 보장.
 * pipelineVersion 은 모델 ID·프롬프트·패치 알고리즘·검증 정책 버전을 전부 담는다 —
 * 어느 하나라도 바뀌면 키가 달라져 구버전 결과가 새 파이프라인에 자동 재사용되지 않는다.
 */
model TranslationCache {
  sha256          String
  pipelineVersion String
  status          String // VERIFIED | NO_FOREIGN_TEXT | NEEDS_REVIEW | VERIFICATION_FAILED | RETRYABLE | FAILED
  ocrData         String? // 교차 OCR + 확정 번역 JSON
  resultFile      String? // 번역본(또는 검수 후보) 파일 — StoredFile.name
  storedFile      StoredFile? @relation(fields: [resultFile], references: [name], onDelete: SetNull)
  verifyData      String? // 검수 결과·사유 JSON
  // 끊어진 캐시 — 파일 소실·손상·운영자 거부로 재사용 불가가 된 시각·사유
  staleAt         DateTime?
  staleReason     String?
  createdAt       DateTime @default(now())

  @@id([sha256, pipelineVersion])
  @@index([resultFile])
}

/** 1688 수집 이력 — 실패 원인 추적과 재시도를 위해 남긴다. */
model ImportJob {
  id        String   @id @default(cuid())
  source    String   @default("1688")
  sourceId  String
  sourceUrl String
  status    String   @default("PENDING") // PENDING | DONE | FAILED
  rawTitle  String   @default("")
  koTitle   String   @default("")
  imageCount Int     @default(0)
  error     String?
  productId String?
  createdAt DateTime @default(now())

  @@index([status])
}

model PriceTier {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  unitPrice Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  /**
   * 고른 옵션. 옵션 없는 상품은 빈 문자열 —
   * null 로 두면 Postgres 가 NULL 을 서로 다른 값으로 봐서 같은 상품이
   * 장바구니에 여러 줄 쌓인다(unique 가 안 걸린다).
   */
  optionId  String  @default("")
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, optionId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  status      String      @default("RECEIVED")
  recipient   String
  phone       String
  address     String
  memo        String?
  /** 주문 시 고른 결제 수단 (src/lib/paymentMethods.ts PAYMENT_METHODS 의 value) */
  paymentMethod String    @default("")
  subtotal    Int
  shippingFee Int
  total       Int
  /** 택배사 코드 (src/lib/shipping.ts COURIERS). 미발송이면 빈 문자열 */
  courier     String      @default("")
  /** 운송장번호. 영숫자만 정규화해 저장하며, 비어 있으면 미발송 */
  trackingNo  String      @default("")
  shippedAt   DateTime?
  canceledAt  DateTime?
  /** 취소 주체. MEMBER | ADMIN (취소 전에는 빈 문자열) */
  canceledBy  String      @default("")
  cancelReason String     @default("")
  /**
   * 무통장 입금 확인. null 이면 접수됐어도 아직 돈이 안 들어온 것으로 본다 —
   * 예전엔 둘 다 RECEIVED 하나라 미입금과 입금완료를 구분할 방법이 없었다.
   */
  depositConfirmedAt DateTime?
  /** 입금 확인을 처리한 관리자 아이디 — 누가 보고 발송을 열었는지 남긴다 */
  depositConfirmedBy String  @default("")
  /** 통장에 찍힌 입금자명. 사업자 주문은 주문자와 다른 경우가 흔해 대사에 꼭 필요하다 */
  depositorName      String  @default("")
  /** 실제 입금액. 주문 총액과 다르면(부분·초과 입금) 이 숫자가 대사 근거가 된다 */
  depositAmount      Int     @default(0)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?

  /** 어드민 '입금대기' 필터 — 무통장 + 접수됨 + 미확인 을 한 번에 훑는다 */
  @@index([paymentMethod, status, depositConfirmedAt])
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  paymentId   String    @unique // 포트원 결제 식별자 (고객사 채번)
  pgTxId      String?
  channel     String    @default("kcp")
  method      String? // CARD | TRANSFER | EASY_PAY
  amount      Int
  status      String    @default("READY") // READY | PAID | CANCELED | FAILED
  approvedAt  DateTime?
  canceledAt  DateTime?
  rawResponse String?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  brand     String
  /** 주문 시점의 품번 스냅샷. 나중에 상품 품번이 바뀌어도 주문서는 그대로 남아야 한다. */
  sku       String @default("")
  /** 주문 시점의 옵션명 스냅샷. 옵션을 지워도 주문서에는 남아야 한다 */
  optionName String @default("")
  /** 취소 시 재고를 뺀 곳으로 되돌리기 위한 참조. 옵션이 없으면 빈 문자열 */
  optionId   String @default("")
  unitPrice Int
  quantity  Int
  lineTotal Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Faq {
  id        String  @id @default(cuid())
  category  String
  question  String
  answer    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/** 운영자가 어드민에서 바꾸는 사이트 설정 (배송비 등). key-value 저장 */
model Setting {
  key   String @id
  value String
}

model Category {
  /** URL 에 그대로 쓰는 식별자 (예: women). 상품이 categorySlug 문자열로 참조한다. */
  slug      String  @id
  name      String
  /** Icon 컴포넌트 키 */
  icon      String  @default("sparkle")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  /**
   * 상위 카테고리. null 이면 대분류(헤더에 노출되는 줄)이고,
   * 값이 있으면 그 대분류 아래의 세부 카테고리다. 2단까지만 쓴다 —
   * 3단부터는 운영자가 관리하기 어렵고 매장 화면도 감당이 안 된다.
   */
  parentSlug String?
  parent     Category?  @relation("CategoryTree", fields: [parentSlug], references: [slug], onDelete: SetNull)
  children   Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@index([parentSlug])
}

model Banner {
  id             String   @id @default(cuid())
  eyebrow        String
  title          String
  subtitle       String
  /**
   * 슬라이드 배경 이미지. 비어 있으면 코드에 있는 기본 히어로 이미지를 쓴다 —
   * 배너를 추가했는데 배경이 비어 보이는 일이 없도록.
   */
  image          String   @default("")
  /** 모바일 전용 배경. 비어 있으면 image 를, 그것도 없으면 기본 이미지를 쓴다. */
  imageMobile    String   @default("")
  primaryLabel   String
  primaryHref    String
  secondaryLabel String
  secondaryHref  String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  kind      String   // notice | stock | event
  tag       String
  text      String
  body      String   @default("") // 공지 상세 본문 (비어 있으면 목록에서 상세 링크 없이 표시)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Inquiry {
  id         String    @id @default(cuid())
  userId     String
  type       String // GENERAL | PARTNER_APPLY | BULK | ALLIANCE
  title      String
  content    String
  status     String    @default("OPEN") // OPEN | ANSWERED
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * 감사 로그 — "누가 언제 무엇을 했는지".
 *
 * 승인·취소·환불·비밀번호 발급처럼 되돌리기 어렵거나 돈이 걸린 동작은
 * 기록이 없으면 사고가 났을 때 원인도 책임도 확인할 수 없다.
 * 로그는 앱에서 수정·삭제하지 않는다(append-only).
 */
/**
 * 업로드 파일 본문. 파일시스템이 아니라 DB에 저장한다 —
 * Railway 컨테이너 디스크는 재배포마다 초기화되고, next start 는
 * 빌드 이후 생긴 public/ 파일을 서빙하지 않기 때문이다.
 * 서빙은 /uploads/[name] 라우트(공개)와 bizcert API(관리자 전용)가 담당.
 */
model StoredFile {
  /** 생성 시 부여한 무작위 파일명 (URL 에 그대로 쓴다) */
  name      String   @id
  mime      String
  /** public: 누구나 조회(상품·배너·로고) | bizcert: 관리자 전용(사업자등록증) */
  access    String   @default("public")
  bytes     Int
  data      Bytes
  createdAt DateTime @default(now())

  // 미러링 원본 주소 — 같은 원격 이미지를 두 번 내려받지 않기 위한 캐시 키.
  // 1688 판매자는 배지·배너를 여러 상품에 재사용하므로, 이걸 기억해 두면
  // 다운로드·저장·이미지 번역 비용이 상품 수만큼 중복으로 나가지 않는다.
  sourceUrl String?

  translationCaches TranslationCache[]

  @@index([sourceUrl])
}

model AuditLog {
  id        String   @id @default(cuid())
  /** 행위자. 시스템(웹훅 등)이면 null */
  actorId   String?
  /** 조회 화면에 그대로 보여줄 이름 — 회원이 탈퇴해도 기록이 남아야 한다 */
  actorName String   @default("")
  actorRole String   @default("")
  /** 무엇을 했는지 (src/lib/audit.ts AUDIT_ACTIONS) */
  action    String
  /** 대상 종류: order | member | product | setting ... */
  target    String   @default("")
  /** 대상 식별자 */
  targetId  String   @default("")
  /** 사람이 읽는 한 줄 요약 */
  summary   String   @default("")
  /** 변경 전/후 등 부가 정보 (JSON 문자열) */
  meta      String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([target, targetId])
}

/**
 * 상단 메뉴(GNB) — 이번주 추천 / 신상품 / 인기상품 / 기획전 / 고객지원.
 * 코드에 박아두면 문구 하나 바꾸는 데도 배포가 필요해 DB 로 옮겼다.
 */
/**
 * 메인 상품 탭 (HOT / 이번주 추천 / 입문 추천 / 재구매 높은 …).
 *
 * mode 가 자동이면 규칙으로 뽑고, MANUAL 이면 운영자가 고른 picks 를 그대로 쓴다.
 * 주문이 없는 초기에는 자동 탭이 비므로, 조회 쪽에서 신상품으로 메꾼다.
 */
model HomeSection {
  id        String     @id @default(cuid())
  label     String
  /** AUTO_NEW | AUTO_POPULAR | AUTO_REPEAT | MANUAL */
  mode      String     @default("AUTO_NEW")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  picks     HomePick[]
}

model HomePick {
  sectionId String
  productId String
  sortOrder Int         @default(0)
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
  @@index([sectionId])
}

model NavLink {
  id        String  @id @default(cuid())
  label     String
  href      String
  /** NEW 같은 작은 배지. 비우면 표시하지 않는다 */
  badge     String  @default("")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}
